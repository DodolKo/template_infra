# =================================================================
# POSTGRESQL CLUSTER CONFIGURATION (Melchior, Balthasar, Casper)
# =================================================================
POSTGRES_DB=app_db
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=postrgres_secret_password

POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replica_secret_password

MELCHIOR_PORT=5432
BALTHASAR_PORT=5433
CASPER_PORT=5434

# =================================================================
# REDIS CACHE CONFIGURATION
# =================================================================
REDIS_PASSWORD=redis_secret_password
REDIS_PORT=6379

# =================================================================
# MINIO OBJECT STORAGE CONFIGURATION
# =================================================================
MINIO_USER=minio_admin
MINIO_PASSWORD=minio_secret_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =================================================================
# HAPROXY LOAD BALANCER CONFIGURATION
# =================================================================
HAPROXY_WRITE_PORT=5000
HAPROXY_READ_PORT=5001
HAPROXY_STATS_PORT=7000
HAPROXY_STATS_PASSWORD=admin

# =================================================================
# ADMINER WEB MANAGEMENT PORT
# =================================================================
ADMINER_PORT=8080

# =================================================================
# LOCAL DASHBOARD CONFIGURATION
# =================================================================
DASHBOARD_PORT=3010
ENABLE_FULL_MONITORING=false

# =================================================================
# MONITORING (PROMETHEUS & GRAFANA) CONFIGURATION
# =================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121